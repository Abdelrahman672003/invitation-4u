# Copy to .env.production on the server. Never commit the real file.
# Wrap a value in double quotes if it contains spaces or < > characters.
# UPLOAD_DIR and TRUST_PROXY are set by docker-compose.yml.
NODE_ENV=production

# --- Database (MySQL container) ---
# Generate two different passwords with `openssl rand -hex 24`. Hex keeps them safe inside the URL below.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=invite
MYSQL_USER=invite
MYSQL_PASSWORD=
# The API's connection: the same user, password and database as above, host `db` (the container).
DATABASE_URL=mysql://invite:PASTE_MYSQL_PASSWORD_HERE@db:3306/invite

# Public address of the site: plain http, on the one port the server exposes (80 by default; if you
# change WEB_PORT, add it here, e.g. http://203.0.113.10:8080). Use the server's IP or a domain.
APP_URL=http://203.0.113.10
CORS_ORIGINS=http://203.0.113.10
# Plain http: cookies cannot be marked Secure, and the API only starts like this when you say so.
# Passwords and sessions then travel unencrypted. With HTTPS in front later, set COOKIE_SECURE=true
# and remove ALLOW_INSECURE_HTTP.
COOKIE_SECURE=false
ALLOW_INSECURE_HTTP=true

# Long random value (`openssl rand -hex 32`). Used by the simulated provider only; keep it set anyway.
PAYMENT_WEBHOOK_SECRET=

# Lemon Squeezy, live mode: a LIVE-mode store, product, API key and webhook (not the test ones).
# The webhook URL to register there is <APP_URL>/api/v1/webhooks/payments/lemonsqueezy
# (Lemon Squeezy may refuse a plain-http or IP-only webhook address; see docs/deployment.md.)
PAYMENT_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Max 40 characters; the same value you typed as the webhook's signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CURRENCY=EGP
LEMONSQUEEZY_RATE=1

# Re-checks stuck pending payments every 15 minutes and cancels abandoned ones.
PAYMENT_SWEEP_ENABLED=true
