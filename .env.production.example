# Copy to .env.production on the server. Never commit the real file.
# Wrap a value in double quotes if it contains spaces or < > characters.
# UPLOAD_DIR and TRUST_PROXY are set by docker-compose.yml.
NODE_ENV=production

# --- Database (MySQL container) ---
# Generate two different passwords with `openssl rand -hex 24`. Hex keeps them safe inside the URL below.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=invite
MYSQL_USER=invite
MYSQL_PASSWORD=
# The API's connection: the same user, password and database as above, host `db` (the container).
DATABASE_URL=mysql://invite:PASTE_MYSQL_PASSWORD_HERE@db:3306/invite

# Public address of the site, exactly as the browser shows it (scheme and domain, plus :port if WEB_PORT
# is not 80). If a TLS proxy such as Cloudflare serves https in front of the server, keep https here.
APP_URL=https://invitation-4u.com
CORS_ORIGINS=https://invitation-4u.com
# The container itself speaks plain http, so cookies are not marked Secure and the API only starts like
# this when you say so. Non-Secure cookies still work behind https. Once every visitor uses https,
# set COOKIE_SECURE=true and remove ALLOW_INSECURE_HTTP.
COOKIE_SECURE=false
ALLOW_INSECURE_HTTP=true

# Long random value (`openssl rand -hex 32`). Used by the simulated provider only; keep it set anyway.
PAYMENT_WEBHOOK_SECRET=

# Lemon Squeezy. For now this uses the TEST-mode store: its test API key, store id and variant id, and a
# test-mode webhook (pay with card 4242 4242 4242 4242). To go live later, replace all four values with
# the live-mode ones and register a live-mode webhook; no code change is needed.
# The webhook URL to register there is <APP_URL>/api/v1/webhooks/payments/lemonsqueezy
PAYMENT_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Max 40 characters; the same value you typed as the webhook's signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CURRENCY=EGP
LEMONSQUEEZY_RATE=1

# Re-checks stuck pending payments every 15 minutes and cancels abandoned ones.
PAYMENT_SWEEP_ENABLED=true
