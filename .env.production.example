# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production

# Your domain, without https://. Caddy gets the certificate for it; its DNS must point at this server.
DOMAIN=example.com
APP_URL=https://example.com
CORS_ORIGINS=https://example.com
COOKIE_SECURE=true

# Long random value (`openssl rand -hex 32`). Used by the simulated provider only; keep it set anyway.
PAYMENT_WEBHOOK_SECRET=

# Lemon Squeezy, live mode: a LIVE-mode store, product, API key and webhook (not the test ones).
# The webhook URL to register there is https://<DOMAIN>/api/v1/webhooks/payments/lemonsqueezy
PAYMENT_PROVIDER=lemonsqueezy
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
# Max 40 characters; the same value you typed as the webhook's signing secret.
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_CURRENCY=EGP
LEMONSQUEEZY_RATE=1

# Re-checks stuck pending payments every 15 minutes and cancels abandoned ones.
PAYMENT_SWEEP_ENABLED=true

# Backups (the `backup` service): how long to keep copies and how often to take them.
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24
