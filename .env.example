# Copy to .env and adjust. Never commit real secrets.

# --- Database (SQLite files, relative to the prisma/ folder) ---
DATABASE_URL="file:./dev.db"
TEST_DATABASE_URL="file:./test.db"

# --- API ---
NODE_ENV=development
API_PORT=4000
# Public base URL of the web app (used in emails and share links)
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:5173
# Session lifetime in days
SESSION_TTL_DAYS=30
# Set to true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (for correct client IPs / rate limiting)
TRUST_PROXY=0

# --- Email (console adapter logs emails in development) ---
EMAIL_PROVIDER=console
EMAIL_FROM="Daawa <no-reply@example.com>"

# --- Seeded development administrator (only used by `npm run db:seed`) ---
SEED_ADMIN_EMAIL=admin@invite.test
SEED_ADMIN_PASSWORD=Admin-Dev-Password-1
SEED_ADMIN_NAME="Platform Admin"

# Public support email shown on the contact page (optional)
VITE_SUPPORT_EMAIL=


# Payments: simulated test provider (development only). Webhooks are verified with this secret.
PAYMENT_PROVIDER=test
PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret-change-me
# Lemon Squeezy (set PAYMENT_PROVIDER=lemonsqueezy; see docs/payments.md). The first four are required.
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_VARIANT_ID=             # any variant; checkouts override its price
# LEMONSQUEEZY_WEBHOOK_SECRET=         # the signing secret you set on the webhook
# LEMONSQUEEZY_CURRENCY=USD            # the store's currency
# LEMONSQUEEZY_RATE=50                 # EGP per 1 USD; prices are converted at checkout
# Paymob (set PAYMENT_PROVIDER=paymob to use it; see docs/payments.md). All five are then required.
# PAYMOB_SECRET_KEY=
# PAYMOB_PUBLIC_KEY=
# PAYMOB_API_KEY=
# PAYMOB_HMAC_SECRET=
# PAYMOB_INTEGRATION_IDS=123456        # card integration id(s), comma separated
# PAYMOB_NOTIFICATION_URL=             # public https URL of /api/v1/webhooks/payments/paymob
# PAYMENT_SWEEP_ENABLED=false          # re-check stuck pending payments every 15 minutes
